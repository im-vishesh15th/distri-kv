+import {
+  HomeIcon,
+  KeyIcon,
+  ChartBarIcon,
+  Cog6ToothIcon,
+  ArrowRightOnRectangleIcon,
+  UsersIcon,
+  ShieldCheckIcon,
+  Bars3Icon,
+  XMarkIcon,
+  DocumentTextIcon,
+} from '@heroicons/react/24/outline'
+
+const customerNav = [
+  { name: 'Dashboard', href: '/dashboard', icon: HomeIcon },
+  { name: 'API Keys', href: '/keys', icon: KeyIcon },
+  { name: 'Usage', href: '/usage', icon: ChartBarIcon },
+  { name: 'Documentation', href: '/docs', icon: DocumentTextIcon },
+  { name: 'Settings', href: '/settings', icon: Cog6ToothIcon },
+]
+
+const adminFleetNav = [
+  { name: 'Cluster Overview', href: '/admin', icon: ShieldCheckIcon },
+  { name: 'Tenants Fleet', href: '/admin/tenants', icon: UsersIcon },
+  { name: 'Documentation', href: '/docs', icon: DocumentTextIcon },
+  { name: 'Settings', href: '/settings', icon: Cog6ToothIcon },
+]
+
+function NavItem({ href, icon: Icon, name }: { href: string; icon: React.ElementType; name: string }) {
+  return (
+    <NavLink
+      to={href}
+      end={href === '/dashboard' || href === '/admin'}
+      className={({ isActive }) =>
+        `nav-item ${isActive ? 'active' : ''}`
+      }
+    >
+      <Icon className="h-[18px] w-[18px] flex-shrink-0" />
+      <span>{name}</span>
+    </NavLink>
+  )
+}
+
+function Sidebar({ user, logout }: { user: NonNullable<ReturnType<typeof useAuth>['user']>; logout: () => void }) {
+  const initials = user.email.substring(0, 2).toUpperCase()
+  const isOperatorOnly = user.is_admin && !user.tenant_id
+
+  return (
+    <nav className="sidebar">
+      {/* Logo */}
+      <div className="px-5 py-5 mb-2" style={{ borderBottom: '1px solid #f0f0f0' }}>
+        <span
+          className="font-[400] text-[20px] text-ink-black tracking-tight select-none"
+          style={{ fontFamily: "'Signifier', ui-serif, Georgia, serif" }}
+        >
+          DistriKV
+        </span>
+      </div>
+
+      {/* Main nav */}
+      <div className="flex-1 px-3 py-3 space-y-0.5 overflow-y-auto">
+        {isOperatorOnly ? (
+          adminFleetNav.map((item) => <NavItem key={item.href} {...item} />)
+        ) : (
+          <>
+            {customerNav.map((item) => (
+              <NavItem key={item.href} {...item} />
+            ))}
+
+            {user.is_admin && (
+              <>
+                <div className="pt-5 pb-2 px-3">
+                  <p className="text-overline">Admin</p>
+                </div>
+                <NavItem href="/admin" icon={ShieldCheckIcon} name="Cluster Overview" />
+                <NavItem href="/admin/tenants" icon={UsersIcon} name="Tenants Fleet" />
+              </>
+            )}
+          </>
+        )}
+      </div>
+
+      {/* User + logout */}
+      <div className="px-3 pb-4 pt-3" style={{ borderTop: '1px solid #f0f0f0' }}>
+        <div className="flex items-center gap-3 px-3 py-2.5 mb-1">
+          {/* Avatar */}
+          <div
+            className="w-8 h-8 rounded-full flex items-center justify-center text-[12px] font-[600] text-paper-white flex-shrink-0"
+            style={{ background: '#17191c' }}
+          >
+            {initials}
+          </div>
+          <div className="flex-1 min-w-0">
+            <p className="text-[14px] font-[500] text-ink-black truncate">{user.email}</p>
+            {user.tenant_name && (
+              <p className="text-[12px] text-slate-gray truncate">{user.tenant_name}</p>
+            )}
+          </div>
+        </div>
+        <button
+          onClick={logout}
+          className="nav-item w-full text-slate-gray hover:text-ink-black"
+        >
+          <ArrowRightOnRectangleIcon className="h-[18px] w-[18px]" />
+          <span>Sign out</span>
+        </button>
+      </div>
+    </nav>
+  )
+}
+
+export function Layout() {
+  const { user, logout, loading } = useAuth()
+  const navigate = useNavigate()
+  const [mobileOpen, setMobileOpen] = useState(false)
+
+  const handleLogout = async () => {
+    await logout()
+    navigate('/login')
+  }
+
+  if (loading) {
+    return (
+      <div className="min-h-screen flex items-center justify-center bg-paper-white">
+        <div className="flex flex-col items-center gap-4">
+          <div className="w-8 h-8 border-2 border-mist-gray border-t-ink-black rounded-full animate-spin" />
+          <p className="text-[14px] text-slate-gray">Loading…</p>
+        </div>
+      </div>
+    )
+  }
+
+  // Unauthenticated — render outlet only (for public routes wrapped in Layout)
+  if (!user) {
+    return <Outlet />
+  }
+
+  return (
+    <>
+      {/* Desktop layout: CSS grid */}
+      <div className="hidden lg:grid h-screen overflow-hidden" style={{ gridTemplateColumns: '240px 1fr' }}>
+        <Sidebar user={user} logout={handleLogout} />
+
+        {/* Right column */}
+        <div className="flex flex-col h-screen overflow-hidden bg-paper-white">
+          {/* Sticky header */}
+          <header className="app-header">
+            <div />
+            <div className="flex items-center gap-3">
+              <span
+                className="text-[12px] font-[500] px-2.5 py-1 rounded-full"
+                style={{ background: '#f2f2f3', color: '#777b86' }}
+              >
+                Data Plane
+              </span>
+              {user.is_admin && (
+                <span
+                  className="text-[12px] font-[500] px-2.5 py-1 rounded-full"
+                  style={{ background: '#fbe1d1', color: '#5d2a1a' }}
+                >
+                  Admin
+                </span>
