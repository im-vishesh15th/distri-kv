# Copy to deployments/.env on the VM and edit. Never commit the real .env.
# Contains no secrets by design: API keys, passwords and the SQLite database
# are created at runtime and live only in Docker volumes.

# Public DNS name of the VM (REQUIRED). Must resolve to the VM's public IP.
# No domain? Give the VM's public IP a DNS name label in the Azure portal and use
# <label>.eastasia.cloudapp.azure.com (free). See docs/deploy-azure.md.
DOMAIN=distrikv.eastasia.cloudapp.azure.com

# Browser origin(s) allowed to call the control API (REQUIRED, comma-separated,
# exact origins, no trailing slash). Set to your Vercel URL once the frontend exists.
CONTROL_ORIGINS=https://your-console.vercel.app

# Let anyone create an account through the console. Leave false on a public VM
# until you have added email verification; create tenants with gatewayctl instead.
CONTROL_SIGNUP=false
