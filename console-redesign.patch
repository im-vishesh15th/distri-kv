+                </div>
+                <div className="flex-1">
+                  <Dialog.Title className="text-[18px] font-[500] text-ink-black">
+                    {title}
+                  </Dialog.Title>
+                  <Dialog.Description className="mt-2 text-[15px] text-slate-gray leading-relaxed">
+                    {description}
