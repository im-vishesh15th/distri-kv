+        },
+        query: {
+          useQuery: true,
+          useInfiniteQuery: false,
+        },
+        mutator: {
+          path: './src/lib/axios-instance.ts',
+          name: 'customInstance',
+        },
+      },
+    },
+    hooks: {
+      afterAllFilesWrite: 'prettier --write',
+    },
+  },
+}
