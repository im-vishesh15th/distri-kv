+    enabled: !!id,
+  })
+
+  const { data: tenantKeys = [] } = useQuery({
+    queryKey: ['adminTenantKeys', id],
+    queryFn: async () => {
+      try {
+        const response = await api.get(`/admin/tenants/${id}/keys`)
+        return (response.data.keys || []) as ApiKey[]
+      } catch {
+        return []
+      }
