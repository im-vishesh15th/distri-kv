diff --git a/docs/openapi.yaml b/docs/openapi.yaml
new file mode 100644
index 0000000..5bc48ad
--- /dev/null
+++ b/docs/openapi.yaml
@@ -0,0 +1,403 @@
+openapi: 3.0.3
+info:
+  title: DistriKV control-plane API
+  version: "1.0"
+  description: >
+    JSON API behind the DistriKV web console. Authentication is a session cookie
+    (dkv_session; HttpOnly, SameSite=Strict). Browsers must call with credentials and
+    from an origin listed in the gateway's -control-origins. Errors always use the
+    Error schema. See docs/control-api.md.
+servers:
+  - url: http://localhost:9091/api/v1
+tags:
+  - {name: public}
+  - {name: customer}
+  - {name: admin}
+components:
+  securitySchemes:
+    session:
+      type: apiKey
+      in: cookie
+      name: dkv_session
+  schemas:
+    Error:
+      type: object
+      required: [error]
+      properties:
+        error:
+          type: object
+          required: [code, message]
+          properties:
+            code: {type: string, example: invalid_credentials}
+            message: {type: string}
+    User:
+      type: object
+      required: [id, email, is_admin, created_at]
+      properties:
+        id: {type: string}
+        email: {type: string, format: email}
+        is_admin: {type: boolean}
+        tenant_id: {type: string}
+        created_at: {type: string, format: date-time}
+    Tenant:
+      type: object
+      properties:
+        id: {type: string}
+        name: {type: string}
+        created_at: {type: string, format: date-time}
+        quota_rps: {type: number, description: "0 = gateway default"}
+        quota_burst: {type: integer, description: "0 = gateway default"}
+        effective_rps: {type: number}
+        effective_burst: {type: integer}
+        max_concurrent: {type: integer}
+        max_keys: {type: integer}
+        max_key_ttl_hours: {type: integer}
+    Key:
+      type: object
+      properties:
+        prefix: {type: string, example: dkv_live_ab12cd34}
+        name: {type: string}
+        status: {type: string, enum: [active, expired, revoked]}
+        created_at: {type: string, format: date-time}
+        expires_at: {type: string, format: date-time, nullable: true}
+        revoked_at: {type: string, format: date-time, nullable: true}
+    NewKey:
+      type: object
+      properties:
+        key: {type: string, description: "Plaintext API key. Shown once."}
+        info: {$ref: "#/components/schemas/Key"}
+    Usage:
+      type: object
+      properties:
+        since: {type: string, format: date-time}
+        requests: {type: integer}
+        by_op: {type: object, additionalProperties: {type: integer}}
+        by_status: {type: object, additionalProperties: {type: integer}}
+        rate_limited: {type: integer}
+        concurrency_limited: {type: integer}
+    UserAndTenant:
+      type: object
+      properties:
+        user: {$ref: "#/components/schemas/User"}
+        tenant: {$ref: "#/components/schemas/Tenant"}
+  responses:
+    Err:
+      description: Error
+      content:
+        application/json:
+          schema: {$ref: "#/components/schemas/Error"}
+  parameters:
+    Prefix:
+      name: prefix
+      in: path
+      required: true
+      schema: {type: string, pattern: '^dkv_live_[0-9a-f]{8}$'}
+    TenantId:
+      name: id
+      in: path
+      required: true
+      schema: {type: string, pattern: '^[a-z0-9][a-z0-9_-]{0,62}$'}
+paths:
+  /health:
+    get:
+      tags: [public]
+      responses:
+        "200": {description: OK}
+  /auth/signup:
+    post:
+      tags: [public]
+      summary: Create an account, its tenant, a first API key, and a session
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              type: object
+              required: [email, password]
+              properties:
+                email: {type: string, format: email}
+                password: {type: string, minLength: 10, maxLength: 128}
+                tenant_id: {type: string, pattern: '^[a-z0-9][a-z0-9_-]{0,62}$'}
+                name: {type: string, maxLength: 80}
+      responses:
+        "201":
