{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/kv",
      "destination": "https://distrikv-vishesh.eastasia.cloudapp.azure.com/kv"
    },
    {
      "source": "/kv/:path*",
      "destination": "https://distrikv-vishesh.eastasia.cloudapp.azure.com/kv/:path*"
    },
    {
      "source": "/api/v1",
      "destination": "https://distrikv-vishesh.eastasia.cloudapp.azure.com/api/v1"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://distrikv-vishesh.eastasia.cloudapp.azure.com/api/v1/:path*"
    },
    {
      "source": "/v1/usage",
      "destination": "https://distrikv-vishesh.eastasia.cloudapp.azure.com/v1/usage"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/kv",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/kv/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/v1",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/v1/usage",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}